<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.6-c137 79.159768, 2016/08/11-13:24:42        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <xmp:CreateDate>2019-01-12T15:29:05-08:00</xmp:CreateDate>
         <xmp:CreatorTool>PaperPlaza Conference Manuscript Management System</xmp:CreatorTool>
         <pdf:Keywords>Decision-support for human operators; Assistive devices; Cognitive control</pdf:Keywords>
         <pdf:Producer>PDFlib+PDI 8.0.1p8 (Perl 5.10.0/Linux-x86_64)</pdf:Producer>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Eric Villeneuve, Audrey ABI AKLE, Christophe MERLO, Dimitri Masson, Guillaume TERRASSON, Alvaro Llaria</rdf:li>
            </rdf:Seq>
         </dc:creator>
